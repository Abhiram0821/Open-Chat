{
  "name": "anonymous-chat-app",
  "version": "2.0.0",
  "description": "Anonymous chatting room with voice/video chat capability using WebRTC and Socket.io",
  "main": "server.js",
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "server": "node server.js",
    "server:advanced": "node server-advanced.js",
    "server:dev": "nodemon server.js",
    "server:prod": "NODE_ENV=production node server-advanced.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:build": "docker build -t anonymous-chat:latest .",
    "docker:run": "docker run -p 3001:3001 anonymous-chat:latest",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "serve": "python -m http.server 3000",
    "serve:node": "npx http-server -p 3000",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "check": "npm run lint && npm run test"
  },
  "keywords": [
    "chat",
    "anonymous",
    "webrtc",
    "voice-chat",
    "video-chat",
    "socket.io",
    "peer-to-peer",
    "real-time"
  ],
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.5.4"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "jest": "^29.5.0",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3"
  },
  "optionalDependencies": {
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.7.0",
    "validator": "^13.9.0",
    "winston": "^3.8.2",
    "dotenv": "^16.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/anonymous-chat-app.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/anonymous-chat-app/issues"
  },
  "homepage": "https://github.com/yourusername/anonymous-chat-app#readme",
  "nodemonConfig": {
    "ignore": [
      "node_modules",
      ".git",
      "dist",
      "*.md"
    ],
    "delay": 500
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "warn"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "arrowParens": "avoid"
  }
}
