# Anonymous Chat Application - Environment Configuration

# ============= SERVER CONFIGURATION =============
NODE_ENV=development
PORT=3001

# ============= CORS CONFIGURATION =============
# Frontend URL(s) - comma separated for multiple origins
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============= DATABASE (if using persistence) =============
# MongoDB Example
# MONGODB_URI=mongodb://username:password@localhost:27017/chat-db
# Or MongoDB Atlas
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chat-db

# Firebase Configuration (if using Firebase)
# FIREBASE_API_KEY=your-api-key
# FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-app.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_APP_ID=your-app-id

# ============= SECURITY =============
# JWT Secret (for future authentication)
# JWT_SECRET=your-super-secret-jwt-key-change-this

# API Keys (if using third-party services)
# AGORA_APP_ID=your-agora-app-id
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token

# ============= LOGGING =============
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ============= RATE LIMITING =============
# Rate limit window (milliseconds)
RATE_LIMIT_WINDOW_MS=900000
# Rate limit max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============= SESSION CONFIGURATION =============
# Session timeout in milliseconds (1 hour = 3600000)
SESSION_TIMEOUT=3600000

# ============= GOOGLE ANALYTICS (optional) =============
# REACT_APP_GA_ID=your-google-analytics-id

# ============= FRONTEND CONFIGURATION =============
# Backend server URL for frontend
REACT_APP_SERVER_URL=http://localhost:3001
# Enable advanced features
REACT_APP_ENABLE_ADVANCED=true
# Enable video chat
REACT_APP_ENABLE_VIDEO=true
# Enable screen sharing
REACT_APP_ENABLE_SCREEN_SHARE=true

# ============= DOCKER CONFIGURATION =============
# Docker compose environment
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=anonymous-chat
DOCKER_IMAGE_TAG=latest
